{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afl-coaches-whiteboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARDS",
        "class_name": "SharedBoard"
      }
    ]
  },
  "exports": {
    "SharedBoard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
